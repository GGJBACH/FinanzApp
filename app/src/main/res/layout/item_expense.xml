<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardExpenseItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="14dp">

        <ImageView
            android:id="@+id/ivPaymentMethodIcon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_centerVertical="true"
            android:background="@drawable/rounded_chip_bg"
            android:backgroundTint="@color/chip_bg_cash"
            android:contentDescription="Método de Pago"
            android:padding="8dp"
            android:src="@drawable/ic_cash"
            app:tint="@color/method_cash" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="12dp"
            android:layout_toStartOf="@id/layoutRightInfo"
            android:layout_toEndOf="@id/ivPaymentMethodIcon"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvExpenseTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="Almuerzo Universitario" />

            <TextView
                android:id="@+id/tvExpenseCategoryTag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/primary"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="Alimentación" />

            <TextView
                android:id="@+id/tvExpenseMethodTag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                tools:text="Método: Efectivo" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutRightInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvExpenseAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/danger_red"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="- $ 18.500" />

            <ImageView
                android:id="@+id/btnDeleteExpense"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginTop="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Eliminar Gasto"
                android:src="@drawable/ic_delete"
                app:tint="@color/text_hint" />
        </LinearLayout>

    </RelativeLayout>

</com.google.android.material.card.MaterialCardView>