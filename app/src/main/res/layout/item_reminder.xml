<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardReminder"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="14dp">

        <CheckBox
            android:id="@+id/cbPaidStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:buttonTint="@color/accent_green" />

        <ImageView
            android:id="@+id/ivReminderIcon"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_centerVertical="true"
            android:layout_toEndOf="@id/cbPaidStatus"
            android:background="@drawable/rounded_chip_bg"
            android:backgroundTint="#FFF3E0"
            android:contentDescription="Icono Categoria"
            android:padding="8dp"
            android:src="@drawable/ic_phone"
            app:tint="@color/warning_orange" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="10dp"
            android:layout_toStartOf="@id/layoutReminderRight"
            android:layout_toEndOf="@id/ivReminderIcon"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvReminderTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="Factura del Celular" />

            <TextView
                android:id="@+id/tvReminderDueDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                tools:text="Vence: Día 15 de cada mes" />

            <TextView
                android:id="@+id/tvReminderFixedTag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:background="@drawable/rounded_chip_bg"
                android:backgroundTint="#E8EAF6"
                android:paddingStart="6dp"
                android:paddingTop="2dp"
                android:paddingEnd="6dp"
                android:paddingBottom="2dp"
                android:text="Gasto Fijo Base"
                android:textColor="@color/primary"
                android:textSize="10sp"
                android:textStyle="bold" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutReminderRight"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvReminderAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/warning_orange"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="$ 45.000" />

            <ImageView
                android:id="@+id/btnDeleteReminder"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginTop="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Eliminar Recordatorio"
                android:src="@drawable/ic_delete"
                app:tint="@color/text_hint" />
        </LinearLayout>

    </RelativeLayout>

</com.google.android.material.card.MaterialCardView>